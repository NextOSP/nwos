<?xml version="1.0" encoding="utf-8"?>
<nwos>
    <data>
        <!-- Standalone application (appears as a tile in the Apps menu) -->
        <menuitem id="menu_stock_request_root"
                  name="Stock Requests"
                  web_icon="nwos_stock_request,static/description/icon.png"
                  sequence="55"
                  groups="nwos_stock_request.group_stock_request_user"/>

        <menuitem id="menu_stock_request_app"
                  name="Requests"
                  parent="menu_stock_request_root"
                  action="action_stock_request"
                  sequence="1"/>

        <menuitem id="menu_stock_request_config"
                  name="Configuration"
                  parent="menu_stock_request_root"
                  sequence="90"
                  groups="nwos_stock_request.group_stock_request_manager"/>


        <!-- The approval flow itself is stored in `nwos_approval`, but a stock
             administrator should not have to hunt for it in another app: this
             is the same model, pre-filtered (and pre-filled) for stock.request. -->
        <record id="action_stock_request_approval_rule" model="ir.actions.act_window">
            <field name="name">Approval Rules</field>
            <field name="res_model">approval.rule</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('res_model', '=', 'stock.request')]</field>
            <field name="context" eval="{
                'default_res_model_id': ref('model_stock_request'),
                'default_method_name': 'action_confirm_request',
                'default_reject_method_name': 'action_refuse_from_approval',
            }"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smart_button">
                    Define who has to approve a stock request
                </p>
                <p>
                    Add the approval steps, the amount window they apply to and
                    the auto-approval thresholds. Changes take effect immediately.
                </p>
            </field>
        </record>

        <menuitem id="menu_stock_request_approval_rule"
                  name="Approval Rules"
                  parent="menu_stock_request_config"
                  action="action_stock_request_approval_rule"
                  groups="nwos_approval.group_approval_manager"
                  sequence="1"/>

        <menuitem id="menu_stock_request_settings"
                  name="Settings"
                  parent="menu_stock_request_config"
                  action="stock.action_stock_config_settings"
                  sequence="10"/>

        <!-- Also reachable from Inventory and Purchase -->
        <menuitem id="menu_stock_request"
                  name="Stock Requests"
                  parent="stock.menu_stock_warehouse_mgmt"
                  action="action_stock_request"
                  sequence="15"
                  groups="nwos_stock_request.group_stock_request_user"/>

        <menuitem id="menu_stock_request_purchase"
                  name="Stock Requests"
                  parent="purchase.menu_purchase_root"
                  action="action_stock_request"
                  sequence="15"
                  groups="nwos_stock_request.group_stock_request_user"/>
    </data>
</nwos>
