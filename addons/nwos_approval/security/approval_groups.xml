<?xml version="1.0" encoding="utf-8"?>
<nwos>
    <data>

        <record model="res.groups.privilege" id="res_groups_privilege_approval">
            <field name="name">Approvals</field>
            <field name="sequence">25</field>
            <field name="category_id" ref="base.module_category_administration"/>
        </record>

        <!-- Anyone can be named an approver, so the user-level access is
             granted to every internal user (base.group_user) directly and the
             record rules keep everything else out of reach. Only the
             administrator group is specific to this app. -->
        <record id="group_approval_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_approval"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

    </data>
</nwos>
