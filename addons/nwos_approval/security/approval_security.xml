<?xml version="1.0" encoding="utf-8"?>
<nwos>
    <data noupdate="0">

        <record id="approval_request_rule_user" model="ir.rule">
            <field name="name">Approval Request: own or to approve</field>
            <field name="model_id" ref="model_approval_request"/>
            <field name="domain_force">['|', '|',
                ('requester_id', '=', user.id),
                ('create_uid', '=', user.id),
                ('step_ids.approver_ids', 'in', user.id)]</field>
            <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
        </record>

        <record id="approval_request_rule_manager" model="ir.rule">
            <field name="name">Approval Request: administrator</field>
            <field name="model_id" ref="model_approval_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(6, 0, [ref('group_approval_manager')])]"/>
        </record>

        <record id="approval_request_rule_company" model="ir.rule">
            <field name="name">Approval Request: multi-company</field>
            <field name="model_id" ref="model_approval_request"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False),
                ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="approval_step_rule_company" model="ir.rule">
            <field name="name">Approval Step: multi-company</field>
            <field name="model_id" ref="model_approval_step"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False),
                ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="approval_rule_rule_company" model="ir.rule">
            <field name="name">Approval Rule: multi-company</field>
            <field name="model_id" ref="model_approval_rule"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False),
                ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</nwos>
