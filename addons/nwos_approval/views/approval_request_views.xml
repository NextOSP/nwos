<?xml version="1.0" encoding="utf-8"?>
<nwos>
    <data>

        <record id="approval_request_view_list" model="ir.ui.view">
            <field name="name">approval.request.list</field>
            <field name="model">approval.request</field>
            <field name="arch" type="xml">
                <list string="Approvals" create="false"
                      decoration-warning="state == 'pending'"
                      decoration-danger="state in ('rejected', 'error')"
                      decoration-muted="state == 'cancel'">
                    <field name="name"/>
                    <field name="res_model_name" string="Document Type"/>
                    <field name="res_name" string="Document"/>
                    <field name="requester_id" widget="many2one_avatar_user"/>
                    <field name="amount" optional="show"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="date_submitted" optional="hide"/>
                    <field name="state" widget="badge"
                           decoration-success="state in ('approved', 'done')"
                           decoration-warning="state == 'pending'"
                           decoration-danger="state in ('rejected', 'error')"/>
                    <button name="action_open_document" type="object" title="Open Document"
                            icon="fa-external-link"/>
                </list>
            </field>
        </record>

        <record id="approval_request_view_kanban" model="ir.ui.view">
            <field name="name">approval.request.kanban</field>
            <field name="model">approval.request</field>
            <field name="arch" type="xml">
                <kanban default_group_by="res_model_name" create="false">
                    <field name="state"/>
                    <templates>
                        <t t-name="card">
                            <div class="d-flex justify-content-between">
                                <strong><field name="res_name"/></strong>
                                <field name="state" widget="label_selection"
                                       options="{'classes': {'pending': 'warning', 'approved': 'success', 'done': 'success', 'rejected': 'danger', 'error': 'danger', 'cancel': 'default'}}"/>
                            </div>
                            <div class="text-muted">
                                <field name="name"/> — <field name="rule_id"/>
                            </div>
                            <div class="mt-1">
                                <field name="amount" widget="monetary"/>
                            </div>
                            <footer class="pt-2">
                                <field name="requester_id" widget="many2one_avatar_user"/>
                                <button name="action_open_document" type="object"
                                        class="btn btn-sm btn-link ms-auto">Open</button>
                            </footer>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="approval_request_view_form" model="ir.ui.view">
            <field name="name">approval.request.form</field>
            <field name="model">approval.request</field>
            <field name="arch" type="xml">
                <form string="Approval Request" create="false">
                    <header>
                        <button name="approval_action_approve" type="object" string="Approve"
                                class="btn-primary" invisible="not can_approve"/>
                        <button name="approval_action_reject" type="object" string="Refuse"
                                invisible="not can_approve"/>
                        <button name="action_retry" type="object" string="Retry Action"
                                invisible="state != 'error'"
                                groups="nwos_approval.group_approval_manager"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="pending,approved,done"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_open_document" type="object"
                                    class="oe_stat_button" icon="fa-external-link">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">Open</span>
                                    <span class="o_stat_text">Document</span>
                                </div>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="res_model_name" string="Document Type"/>
                                <field name="res_name" string="Document"/>
                                <field name="method_name" string="Requested Action"/>
                                <field name="rule_id"/>
                            </group>
                            <group>
                                <field name="requester_id"/>
                                <field name="amount"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="date_submitted"/>
                                <field name="date_resolved" invisible="not date_resolved"/>
                                <field name="can_approve" invisible="1"/>
                            </group>
                        </group>
                        <div class="alert alert-danger" role="alert"
                             invisible="state != 'rejected'">
                            Refused: <field name="reject_reason" readonly="1" nolabel="1"/>
                        </div>
                        <notebook>
                            <page string="Steps" name="steps">
                                <field name="step_ids" readonly="1">
                                    <list decoration-success="status == 'approved'"
                                          decoration-danger="status == 'rejected'"
                                          decoration-bf="is_current">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="approver_names" string="Approvers"/>
                                        <field name="approval_mode"/>
                                        <field name="approved_user_ids" widget="many2many_tags"/>
                                        <field name="status" widget="badge"
                                               decoration-success="status == 'approved'"
                                               decoration-danger="status == 'rejected'"/>
                                        <field name="is_current" column_invisible="1"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Failure" name="error" invisible="not error_trace">
                                <field name="error_trace" readonly="1" widget="text"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="approval_request_view_search" model="ir.ui.view">
            <field name="name">approval.request.search</field>
            <field name="model">approval.request</field>
            <field name="arch" type="xml">
                <search string="Approvals">
                    <field name="name"/>
                    <field name="res_name" string="Document"/>
                    <field name="requester_id"/>
                    <filter name="filter_to_approve" string="Waiting for me"
                            domain="[('state', '=', 'pending'), ('pending_approver_ids', 'in', uid)]"/>
                    <filter name="filter_my_requests" string="My Requests"
                            domain="[('requester_id', '=', uid)]"/>
                    <separator/>
                    <filter name="filter_pending" string="Pending"
                            domain="[('state', '=', 'pending')]"/>
                    <filter name="filter_done" string="Approved"
                            domain="[('state', 'in', ('approved', 'done'))]"/>
                    <filter name="filter_rejected" string="Refused"
                            domain="[('state', '=', 'rejected')]"/>
                    <group name="group_by">
                        <filter name="group_model" string="Document Type"
                                context="{'group_by': 'res_model_name'}"/>
                        <filter name="group_state" string="Status"
                                context="{'group_by': 'state'}"/>
                        <filter name="group_requester" string="Requester"
                                context="{'group_by': 'requester_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="approval_request_action_my" model="ir.actions.act_window">
            <field name="name">To Approve</field>
            <field name="res_model">approval.request</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="context">{'search_default_filter_to_approve': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smart_button">Nothing waiting for you</p>
                <p>Documents needing your approval show up here.</p>
            </field>
        </record>

        <record id="approval_request_action_all" model="ir.actions.act_window">
            <field name="name">All Approvals</field>
            <field name="res_model">approval.request</field>
            <field name="view_mode">list,kanban,form</field>
        </record>

    </data>
</nwos>
