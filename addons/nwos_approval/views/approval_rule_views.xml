<?xml version="1.0" encoding="utf-8"?>
<nwos>
    <data>

        <record id="approval_rule_view_form" model="ir.ui.view">
            <field name="name">approval.rule.form</field>
            <field name="model">approval.rule</field>
            <field name="arch" type="xml">
                <form string="Approval Rule">
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                                invisible="active"/>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" placeholder="e.g. Sales orders above 10,000"/></h1>
                        </div>
                        <group>
                            <group string="Document">
                                <field name="res_model_id" options="{'no_create': True, 'no_open': True}"/>
                                <field name="res_model" invisible="1"/>
                                <field name="active" invisible="1"/>
                                <field name="method_name" invisible="not res_model_id"
                                       placeholder="action_confirm"/>
                                <field name="method_hint" invisible="not res_model_id"
                                       readonly="1" string="Available"/>
                            </group>
                            <group string="Settings">
                                <field name="sequence"/>
                                <field name="company_id" groups="base.group_multi_company"
                                       options="{'no_create': True}"/>
                                <field name="override_group_id" options="{'no_create': True}"/>
                                <field name="block_mode"/>
                            </group>
                        </group>
                        <div class="alert alert-info" role="alert" invisible="res_model_id">
                            Pick the document model first — the fields below depend on it.
                        </div>
                        <group string="Applies When" invisible="not res_model_id">
                            <field name="condition_domain" widget="domain"
                                   options="{'model': 'res_model'}" nolabel="1" colspan="2"/>
                            <field name="amount_field_id" options="{'no_create': True}"/>
                            <field name="currency_field_id" options="{'no_create': True}"
                                   invisible="not amount_field_id"/>
                            <label for="amount_min" invisible="not amount_field_id"/>
                            <div class="o_row" invisible="not amount_field_id">
                                <field name="amount_min"/>
                                <span class="mx-2">to</span>
                                <field name="amount_max"/>
                                <span class="text-muted ms-2">(0 = no limit)</span>
                            </div>
                        </group>
                        <notebook invisible="not res_model_id">
                            <page string="Approval Steps" name="steps">
                                <field name="step_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="res_model_id" column_invisible="1"/>
                                        <field name="name"/>
                                        <field name="approver_type"/>
                                        <field name="group_id"
                                               invisible="approver_type != 'group'"
                                               required="approver_type == 'group'"
                                               options="{'no_create': True}"/>
                                        <field name="user_ids" widget="many2many_tags"
                                               invisible="approver_type != 'users'"
                                               required="approver_type == 'users'"/>
                                        <field name="approver_field_id"
                                               invisible="approver_type != 'field'"
                                               required="approver_type == 'field'"
                                               options="{'no_create': True}"/>
                                        <field name="manager_level"
                                               invisible="approver_type != 'manager'"/>
                                        <field name="approval_mode"/>
                                    </list>
                                </field>
                                <p class="text-muted mt-2">
                                    Steps are requested one after the other. With no step at
                                    all, the Override Group approves in a single step.
                                </p>
                            </page>
                            <page string="Auto-Approval" name="auto">
                                <field name="auto_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="user_ids" widget="many2many_tags"/>
                                        <field name="max_amount"/>
                                        <field name="scope"/>
                                    </list>
                                </field>
                                <p class="text-muted mt-2">
                                    Small documents can skip approval entirely. Requires an
                                    Amount Field above.
                                </p>
                            </page>
                            <page string="Notification" name="notification">
                                <group>
                                    <field name="mail_template_id" options="{'no_create': True}"/>
                                    <field name="reject_method_name" placeholder="action_refuse"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="approval_rule_view_list" model="ir.ui.view">
            <field name="name">approval.rule.list</field>
            <field name="model">approval.rule</field>
            <field name="arch" type="xml">
                <list string="Approval Rules">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="res_model_id"/>
                    <field name="method_name"/>
                    <field name="amount_min" optional="show"/>
                    <field name="amount_max" optional="show"/>
                    <field name="company_id" groups="base.group_multi_company" optional="show"/>
                </list>
            </field>
        </record>

        <record id="approval_rule_action" model="ir.actions.act_window">
            <field name="name">Approval Rules</field>
            <field name="res_model">approval.rule</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smart_button">
                    Define your first approval rule
                </p>
                <p>
                    Pick a document model and the button that should require approval,
                    then list who has to sign off.
                </p>
            </field>
        </record>

    </data>
</nwos>
