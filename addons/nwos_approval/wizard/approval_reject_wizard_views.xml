<?xml version="1.0" encoding="utf-8"?>
<nwos>
    <data>

        <record id="approval_reject_wizard_view_form" model="ir.ui.view">
            <field name="name">approval.reject.wizard.form</field>
            <field name="model">approval.reject.wizard</field>
            <field name="arch" type="xml">
                <form string="Refuse">
                    <group>
                        <field name="request_id" invisible="1"/>
                        <field name="step_id" invisible="1"/>
                        <field name="document_name" readonly="1" string="Document"/>
                        <field name="reason" placeholder="Why is this refused?"/>
                    </group>
                    <footer>
                        <button name="action_confirm" type="object" string="Refuse"
                                class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</nwos>
