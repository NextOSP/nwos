# Copy to .env and adjust. `docker compose` reads .env automatically.

# Image used by web/cron.
# Servers: leave as-is and `docker compose pull` the image CI publishes.
# Local dev: set to nwos:local and `docker compose build`.
NWOS_IMAGE=ghcr.io/nextosp/nwos:latest

# Server config file. Point this at an untracked copy so `git pull` during a
# self-update never conflicts with your local admin_passwd / worker tuning:
#   cp docker/nwos.conf docker/nwos.local.conf   &&   NWOS_CONF=./docker/nwos.local.conf
NWOS_CONF=./docker/nwos.conf

# Host ports published for Nginx Proxy Manager to forward to.
# 9600 = HTTP (main app), 9601 = websocket / longpolling (gevent worker)
NWOS_HTTP_PORT=9600
NWOS_GEVENT_PORT=9601

# The NWOS application database (created via the DB manager or the init command).
# Used by scripts/backup-compose.sh and scripts/restore-compose.sh.
NWOS_DB_NAME=nwos

# Postgres. POSTGRES_DB is only the maintenance database the server cluster boots
# with - keep it as `postgres` so NWOS can create/drop its own databases.
POSTGRES_DB=postgres
POSTGRES_USER=nwos
POSTGRES_PASSWORD=nwos
# Expose Postgres on the host (optional; comment the ports block in compose to disable)
POSTGRES_HOST_PORT=9632

# Note: the master password for /web/database/manager lives in docker/nwos.conf
# (admin_passwd). Change it there before exposing this publicly.
